{
    // ==== 编辑器基础视觉与排版 ====
    "editor.fontFamily": "Fira Code, JetBrains Mono, Consolas, 'Courier New', monospace", // 优先使用护眼的编程字体
    "editor.fontLigatures": true, // 开启连字 (例如将 -> 显示为连体箭头，非常优雅)
    "editor.fontSize": 18, // 字体大小，适合长时间写代码
    "editor.tabSize": 4, // 按一下 Tab 等效为 4 个空格
    "editor.insertSpaces": true, // 严格使用空格代替 Tab 字符（避免在不同编辑器里排版错乱）
    "editor.wordWrap": "on", // 代码过长时自动换行，不用左右拖动滚动条
    "editor.minimap.enabled": false, // 关闭右侧的迷你代码缩略图，把屏幕空间全留给代码
    "editor.formatOnSave": true, // 【极度推荐】按 Ctrl+S 自动整理代码格式
    // ==== 智能提示行为 ====
    "editor.quickSuggestions": {
        "other": true, // 在正常代码中开启弹窗提示
        "comments": false, // 写注释时不弹提示，让你安心打字
        "strings": true // 在字符串内部允许提示
    },
    "editor.inlineSuggest.enabled": true, // 开启类似 GitHub Copilot 的灰色内联预测文本
    // ==== 自动保存 (再也不怕断电/崩溃) ==== 
    "files.autoSave": "afterDelay", // 停止打字后自动保存
    "files.autoSaveDelay": 500, // 停手 0.5 秒就保存，配合 formatOnSave 食用极佳
    // ==== 终端面板设置 ====
    "workbench.panel.opensMaximized": "never", // 启动时终端面板不要占满全屏
    "terminal.integrated.defaultProfile.linux": "bash", // 默认终端设为 bash
    "terminal.integrated.fontSize": 15, // 终端字号稍微小一点点
    "terminal.integrated.scrollback": 5000, // 终端输出历史保留 5000 行，方便看 CMake 长篇大论的报错
    // =========================================================
    // ==== 🚀 C++ / Clangd 核心护航设置  ====
    // =========================================================
    "C_Cpp.intelliSenseEngine": "disabled", // 【核心】必须禁用微软自带的 C++ 补全，全权交给 clangd，一山不容二虎
    "clangd.path": "/usr/bin/clangd", // clangd 的绝对路径
    "clangd.arguments": [
        // =========================
        // 核心配置
        // =========================
        // 告诉 clangd 编译数据库在哪，这是能找到 Qt/FFmpeg 头文件的关键
        // 你刚才 find 到了在 ./build/Release，所以必须指过来
        "--compile-commands-dir=${workspaceFolder}/build/RelWithDebInfo",
        // 告诉 clangd 你的编译器是谁，让它去问编译器系统头文件在哪
        // 支持 g++ 和 clang++ 双保险
        "--query-driver=/usr/bin/g++,/usr/bin/clang++",
        // =========================
        // 性能配置
        // =========================
        // 后台自动建立索引。第一次打开项目会卡一会，之后跳转、补全快如闪电
        "--background-index",
        // 把预编译头(PCH)放在内存里。吃一点内存，但极大提升代码解析速度
        "--pch-storage=memory",
        // =========================
        // 体验优化 
        // =========================
        // 补全时显示详细的函数签名（返回值 + 参数列表），而不是只显示个函数名
        "--completion-style=detailed",
        // 全局搜索补全。比如你在写一个类成员函数，也能补全出全局的辅助函数
        "--all-scopes-completion",
        // 补全函数时，自动填入参数占位符，按 Tab 键可以快速切换填写下一个参数
        "--function-arg-placeholders=true",
        // 禁止 clangd 自动帮你插入 #include。
        // 原因：clangd 有时候会瞎插（比如插入 <bits/stdc++.h> 或非预期的路径），建议自己控制
        "--header-insertion=never",
        // 开启 clang-tidy 静态检查。会在写代码时实时提示哪里写得不够规范 (比如用了 using namespace std)
        // 注意：这玩意有点吃性能，如果觉得卡可以注释掉
        "--clang-tidy",
        // 让终端里的报错信息排版更好看一点
        "--pretty"
    ],
    // ==== ⌨️ 代码片段与补全策略 ====
    "editor.snippetSuggestions": "inline",
    "editor.tabCompletion": "on",
    "editor.wordBasedSuggestions": "allDocuments", // 开启基于单词的模糊记忆补全（clangd 偶尔反应慢时的兜底护城河）
    // ==== C++ 标准库文件后缀关联 ====
    // 强制把这些无后缀的文件当做 C++ 代码解析，防止它们打开时变成纯文本没有高亮
    "files.associations": {
        "*.h": "cpp",
        "*.hpp": "cpp",
        "iostream": "cpp",
        "vector": "cpp",
        "string": "cpp",
        "map": "cpp",
        "set": "cpp",
        "unordered_map": "cpp",
        "unordered_set": "cpp",
        "memory": "cpp",
        "thread": "cpp",
        "mutex": "cpp",
        "future": "cpp",
        "chrono": "cpp",
        "filesystem": "cpp",
        "algorithm": "cpp",
        "tuple": "cpp",
        "optional": "cpp",
        "variant": "cpp",
        "any": "cpp"
    },
    // ==== Python 设置 (备用) ====
    "python.defaultInterpreterPath": "/usr/bin/python3",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.typeCheckingMode": "basic",
    "python.formatting.provider": "black",
    // ==== 其它杂项 ====
    "git.autofetch": true, // 自动拉取 Git 远端变更
    "git.confirmSync": false, // 点同步时不再烦人地问你确不确认
    "testing.automaticallyOpenPeekViewDuringAutoRun": true,
    "terminal.integrated.stickyScroll.enabled": false, // 关闭终端滚动时的置顶吸附效果
    "explorer.confirmDelete": false, // 删除文件时不再弹窗确认（配合版本控制使用很爽）
    "cmake.sourceDirectory": "${workspaceFolder}",
    "python-envs.defaultEnvManager": "ms-python.python:system" // 明确告诉 CMake 插件你的根目录在哪
}